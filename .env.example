# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Для своего сервера Bot API (docker-compose): ключи с https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Адрес своего сервера Bot API. В docker-compose задаётся автоматически.
# Без него работает обычный api.telegram.org с лимитом 50 МБ.
# BOT_API_URL=http://localhost:8081

# Большие файлы ссылкой (без api_id): адрес сервера, по которому откроется файл.
# Установщик определяет его сам. Пусто — большие файлы режутся на части.
# PUBLIC_URL=http://203.0.113.5:8080
# LARGE_FILE_MODE=link
# WEB_PUBLIC_PORT=8080
# LINK_TTL_HOURS=24

# Необязательно: cookies в формате Netscape (нужны для Instagram, YouTube на сервере, 18+ контента)
# COOKIES_FILE=cookies.txt

# Максимальное качество видео
MAX_HEIGHT=1080
# Больше этого размера не скачиваем совсем (защита диска), МБ
MAX_DOWNLOAD_MB=20000
# Сколько загрузок одновременно
MAX_CONCURRENT=3
# Папка для временных файлов
DOWNLOAD_DIR=downloads
