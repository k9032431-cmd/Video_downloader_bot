# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Необязательно: свой Telegram Bot API сервер (снимает лимит 50 МБ, до 2 ГБ)
# BOT_API_URL=http://localhost:8081

# Необязательно: cookies в формате Netscape (нужны для Instagram, приватного/18+ контента)
# COOKIES_FILE=cookies.txt

# Сколько загрузок одновременно
MAX_CONCURRENT=3
# Папка для временных файлов
DOWNLOAD_DIR=downloads
